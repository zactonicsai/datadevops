# Keycloak console login (http://keycloak:8080 -> Administration Console)
KEYCLOAK_ADMIN_PASSWORD=admin

# OIDC client. The secret MUST match "secret" in keycloak/realm-nifi.json
OIDC_CLIENT_SECRET=nifi-client-secret-change-me

# NiFi initial admin. MUST match the "email" of the nifi-admin user
# in keycloak/realm-nifi.json (NiFi maps the "email" claim to the identity).
NIFI_ADMIN_IDENTITY=admin@nifi.local
NIFI_ADMIN_PASSWORD=nifi-admin-password

# NiFi internals
KEYSTORE_PASSWORD=changeMeKeystore123
NIFI_SENSITIVE_PROPS_KEY=changeMeSensitiveProps123
