{
  "_comment": "Reference policy documents for the pre-existing IAM the Terraform project expects. Hand these to whoever manages IAM. Replace REGION, ACCOUNT_ID, PROJECT and ENV.",
  "keycloak_instance_profile": {
    "_note": "An instance profile of this name must exist and wrap the role below. Set instance_profile_name in your tfvars.",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": { "Service": "ec2.amazonaws.com" },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "managed_policies": [
      "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
    ],
    "inline_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "ReadKeycloakSecrets",
          "Effect": "Allow",
          "Action": ["secretsmanager:GetSecretValue"],
          "Resource": [
            "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:PROJECT-ENV/rds/credentials-*",
            "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:PROJECT-ENV/keycloak/admin-*"
          ]
        },
        {
          "Sid": "DecryptSecretsWithCMK",
          "Effect": "Allow",
          "Action": ["kms:Decrypt"],
          "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/YOUR-KEY-ID",
          "Condition": {
            "StringEquals": { "kms:ViaService": "secretsmanager.REGION.amazonaws.com" }
          }
        },
        {
          "Sid": "WriteContainerLogs",
          "Effect": "Allow",
          "Action": [
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "logs:DescribeLogStreams"
          ],
          "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/ec2/PROJECT-ENV/keycloak:*"
        }
      ]
    }
  },
  "vpc_flow_logs_role": {
    "_when": "enable_vpc_flow_logs = true",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": { "Service": "vpc-flow-logs.amazonaws.com" },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "inline_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "logs:DescribeLogGroups",
            "logs:DescribeLogStreams"
          ],
          "Resource": "*"
        }
      ]
    }
  }
}
